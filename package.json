  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "packageManager": "pnpm@10.34.1",
  "exports": {
    ".": "./dist/off.mjs"
  },
  "bin": {
    "off": "./dist/off.mjs"
  },
  "scripts": {
