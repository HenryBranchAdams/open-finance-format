{
  "name": "@open-finance-format/reference",
  "version": "0.1.0-dev",
  "private": true,
  "description": "Reference contracts and tooling for Open Finance Format 0.1 development after v0.1-rc.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HenryBranchAdams/open-finance-format.git"
  },
  "bugs": {
    "url": "https://github.com/HenryBranchAdams/open-finance-format/issues"
  },
  "homepage": "https://github.com/HenryBranchAdams/open-finance-format#readme",
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "packageManager": "pnpm@10.34.1",
  "exports": {
    ".": "./dist/off.mjs"
  },
  "bin": {
    "off": "./dist/off.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit && node --test test/diagnostics.test.ts test/schema.test.ts test/docs.test.ts && node scripts/release-validate.mjs",
    "test": "node --test test/*.test.ts",
    "test:node22": "node scripts/test-node22.mjs",
    "test:offline": "node scripts/offline-check.mjs",
    "release:self-check": "node scripts/release-validate.mjs --git-snapshot 2570e38998dd735b83da301a5b6f0e95aca47073",
    "verify": "pnpm build && pnpm check && pnpm test && pnpm test:node22 && pnpm test:offline && pnpm release:self-check"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "esbuild": "0.25.12",
    "typescript": "7.0.2"
  }
}
