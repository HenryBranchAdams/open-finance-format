{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openfinanceformat.org/schemas/evaluator-failure-0.1.schema.json",
  "title": "OFF Evaluator Failure 0.1",
  "type": "object",
  "required": ["kind", "code", "operation"],
  "properties": {
    "kind": { "const": "evaluatorFailure" },
    "code": {
      "enum": ["OFF-T1001", "OFF-T1002", "OFF-T1003", "OFF-T1004"]
    },
    "operation": {
      "enum": [
        "resourceLimit",
        "rootAccess",
        "directoryRead",
        "resourceStat",
        "resourceOpen",
        "resourceRead",
        "resourceClose",
        "resourceMutation",
        "configuration",
        "internal"
      ]
    },
    "resourceId": { "type": "string", "minLength": 1 },
    "path": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "code": { "const": "OFF-T1001" } } },
      "then": { "properties": { "operation": { "const": "resourceLimit" } } }
    },
    {
      "if": { "properties": { "code": { "const": "OFF-T1002" } } },
      "then": {
        "properties": {
          "operation": {
            "enum": [
              "rootAccess",
              "directoryRead",
              "resourceStat",
              "resourceOpen",
              "resourceRead",
              "resourceClose"
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "code": { "const": "OFF-T1003" } } },
      "then": { "properties": { "operation": { "const": "resourceMutation" } } }
    },
    {
      "if": { "properties": { "code": { "const": "OFF-T1004" } } },
      "then": {
        "properties": {
          "operation": { "enum": ["configuration", "internal"] }
        }
      }
    }
  ],
  "additionalProperties": false
}
